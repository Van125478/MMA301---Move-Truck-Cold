PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/move_truck
FRONTEND_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
AUTH_SECRET=

# Demo/QA package activation stays off unless every control below is set on a disposable database.
# APP_RUNTIME_MODE=qa
# PACKAGE_DEMO_SELF_ACTIVATION_ENABLED=false
# PACKAGE_DEMO_DEPLOYMENT_ID=
# PACKAGE_DEMO_AUTHORIZED_DEPLOYMENT_ID=

# Commission simulation is off unless every control below is set on a disposable database.
# A request header or query flag cannot turn it on. Production refuses to start when the flag is true.
# COMMISSION_SIMULATION_ENABLED=false
# COMMISSION_SIMULATION_DEPLOYMENT_ID=
# COMMISSION_SIMULATION_AUTHORIZED_DEPLOYMENT_ID=

# TECHNICAL PROPOSAL for cargo-image storage. Not an approved retention or provider policy.
# Leave unset outside production. Production uploads fail closed until this is an absolute directory.
# CARGO_IMAGE_DIR=

# TECHNICAL PROPOSAL for optional incident evidence. Not an approved retention period.
# Leave unset outside production. Production uploads fail closed until this is an absolute directory.
# INCIDENT_EVIDENCE_DIR=

# Local demo sign-in. The real values live only in server/.env, which is gitignored.
# See docs/uat/DEV_LOCAL_CREDENTIALS.md. Do not put a real password in this example.
# npm run seed:demo creates a missing account and does not reset an existing password.
# It refuses databases named coldi, admin, local, or config.
# Database coldi_demo_local also stays refused until DEMO_CREDENTIAL_SYNC_DATABASE equals that name.
# Password sync stays off unless DEMO_CREDENTIAL_SYNC=confirm and DEMO_CREDENTIAL_SYNC_DATABASE equals the connected database.
# Leave CARGO_IMAGE_DIR and INCIDENT_EVIDENCE_DIR unset, or point them at a folder on this computer.
DEMO_SHIPPER_EMAIL=shipper.demo@coldi.local
DEMO_SHIPPER_PASSWORD=
DEMO_CARRIER_EMAIL=carrier.demo@coldi.local
DEMO_CARRIER_PASSWORD=
DEMO_DRIVER_EMAIL=driver.demo@coldi.local
DEMO_DRIVER_PASSWORD=
DEMO_ADMIN_EMAIL=admin.demo@coldi.local
DEMO_ADMIN_PASSWORD=
# DEMO_CREDENTIAL_SYNC=
# DEMO_CREDENTIAL_SYNC_DATABASE=

# World crude oil. Leave the key empty until EIA access is issued. Do not put this key in the frontend.
# EIA_API_KEY=
# OIL_SYNC_ENABLED=false
# OIL_SYNC_TIMES=06:00,18:00
